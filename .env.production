# ══ FRONTEND · PRODUCCIÓN ══
# Sustituye <...> por valores reales. Los secretos van en .env.production.local

# Backend API (sin /api/v1)
NEXT_PUBLIC_API_URL=<https://api.daregular.com>

# Wompi (llave pública de producción)
NEXT_PUBLIC_WOMPI_PUBLIC_KEY=<pub_prod_xxx>

# URL canónica del sitio
NEXT_PUBLIC_SITE_URL=<https://daregular.com>
NEXT_PUBLIC_INDEXABLE=true

# Secretos (en .env.production.local, NO aquí)
# STOREFRONT_REVALIDATE_SECRET=<mismo que en backend>
# STOREFRONT_SERVER_KEY=<mismo que en backend>
