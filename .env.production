# ── PERFIL PRODUCCIÓN ─ backend y base de datos de PRODUCCIÓN ───────────────
# Para salir a producción solo hay que rellenar los valores marcados con <…>
# (la base de datos se configura en el BACKEND: DATABASE_URL / DATABASE_SSL, ver docs/ENTORNOS.md).
# Los secretos reales NO se commitean: defínelos en el entorno del servidor o en `.env.production.local`.
NEXT_PUBLIC_APP_ENV=production
# ── VALIDACIÓN EN PRODUCCIÓN ───────────────────────────────────────────────
# Con NEXT_PUBLIC_APP_ENV=production, `next build`/`next start` FALLAN con un mensaje claro si NEXT_PUBLIC_API_URL o
# NEXT_PUBLIC_SITE_URL faltan, no son https, apuntan a localhost o conservan los marcadores <…> de esta plantilla.
# Sustituye los <…> (incluidos los < >) por valores reales. Ver docs/ENTORNOS.md.

# URL pública del backend (sin /api/v1). Debe ser https y estar en CORS_ORIGINS del backend.
NEXT_PUBLIC_API_URL=<https://api.tu-dominio.com>
# URL interna si el servidor de Next llega al backend por otra ruta (opcional; por defecto = NEXT_PUBLIC_API_URL)
# API_URL=<http://backend:4000>

# Redirecciones del CMS a hosts externos (opcional, separados por comas; vacío = solo rutas internas y el propio sitio)
# REDIRECT_ALLOWED_HOSTS=

# Secretos (solo en el servidor, nunca NEXT_PUBLIC_*)
# STOREFRONT_REVALIDATE_SECRET=<mismo valor que STOREFRONT_REVALIDATE_SECRET del backend>
# STOREFRONT_SERVER_KEY=<mismo valor que STOREFRONT_SERVER_KEY del backend>

# Wompi (llave pública de producción: pub_prod_…)
NEXT_PUBLIC_WOMPI_PUBLIC_KEY=<pub_prod_xxx>

# URL canónica del sitio
NEXT_PUBLIC_SITE_URL=<https://tu-dominio.com>
NEXT_PUBLIC_INDEXABLE=true

CATALOG_REVALIDATE_SECONDS=60
CONTENT_REVALIDATE_SECONDS=300
