# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.production

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# raw photo source (not versioned — see docs/ASSETS.md)
# (los directorios bastan; un `*.JPG` global también ignoraba public/images/*.jpg
#  en Windows por ser core.ignorecase=true)
/iamgenes de la pagina/
/_assets_raw/

# agent-guidance files regenerated by `next dev`
/AGENTS.md
/CLAUDE.md

# Claude Code desktop worktrees
/.claude/

# Codebase memory index (auto-generated)
/.codebase-memory/
