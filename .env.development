# ── PERFIL QA ─ backend y base de datos LOCALES ─────────────────────────────
# Lo usa `yarn dev`. Para probar un build de producción contra QA: `yarn build:qa && yarn start:qa`
# (docs/ENTORNOS.md).
NEXT_PUBLIC_APP_ENV=qa

# URL del backend (sin /api/v1). NEXT_PUBLIC_* la ve el navegador; API_URL es solo para el servidor de Next.
NEXT_PUBLIC_API_URL=http://localhost:4000
API_URL=http://localhost:4000

# SOLO QA, nunca reutilizar en producción: valor de desarrollo, público, igual al STOREFRONT_REVALIDATE_SECRET del backend QA
# (webhook de publicación → /api/revalidate). En producción define un secreto aleatorio propio (openssl rand -hex 32) solo en el servidor.
STOREFRONT_REVALIDATE_SECRET=qa-revalidate-secret-qa-revalidate-0123456789

# QA usa la pasarela simulada del backend (PAYMENT_PROVIDER=mock): no hace falta llave de Wompi.
NEXT_PUBLIC_WOMPI_PUBLIC_KEY=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_INDEXABLE=false

# Segundos de caché (QA: cambios casi inmediatos)
CATALOG_REVALIDATE_SECONDS=5
CONTENT_REVALIDATE_SECONDS=10
