# BACKEND · LOCAL (QA) → copia a `.env` en Department-backend
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug
DATABASE_URL=postgres://postgres:postgres@localhost:5433/department   # tu Postgres local (sin ?sslmode=)
DATABASE_SSL=disable
DATABASE_POOL_MAX=10
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
PUBLIC_URL=http://localhost:4000
STOREFRONT_URL=http://localhost:3000
ADMIN_URL=http://localhost:3000
TRUST_PROXY=false
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=5000               # alto para poder hacer `next build` desde una sola IP
UPLOAD_DIR=./uploads
# Primer owner: `OWNER_EMAIL=... OWNER_PASSWORD=... yarn owner:create` (contraseña de 12+ caracteres)
# OWNER_EMAIL=
# OWNER_PASSWORD=
# En local los secretos son opcionales (el backend usa valores de desarrollo)
# JWT_ACCESS_SECRET=
# JWT_REFRESH_SECRET=
# ENCRYPTION_KEY=
# CUSTOMER_JWT_SECRET=
# PREVIEW_TOKEN_SECRET=
STOREFRONT_REVALIDATE_SECRET=qa-revalidate-secret-qa-revalidate-0123456789   # igual al del frontend
# STOREFRONT_SERVER_KEY=
PAYMENT_PROVIDER=mock
MOCK_PAYMENTS_ENABLED=true        # permite la pasarela simulada /mock-checkout
ORDER_RESERVATION_MINUTES=30
WOMPI_API_URL=https://sandbox.wompi.co/v1
# WOMPI_PUBLIC_KEY=
# WOMPI_INTEGRITY_SECRET=
# WOMPI_EVENTS_SECRET=
MAIL_TRANSPORT=log                # solo registra los correos (sin enviar)
MAIL_FROM="Daregular Dept. <no-reply@daregulardept.com>"
