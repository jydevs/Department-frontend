# BACKEND · PRODUCCIÓN → variables del servidor (NO commitear). Con NODE_ENV=production el backend NO arranca si falta alguna obligatoria.
# Generar secretos: `openssl rand -hex 32` (ENCRYPTION_KEY: `openssl rand -base64 32`). Cada secreto DISTINTO.
NODE_ENV=production
PORT=<puerto del hosting>
LOG_LEVEL=info
GIT_SHA=                                   # lo inyecta tu despliegue
DATABASE_URL=<postgres://usuario:clave@host:5432/db>   # sin ?sslmode=
DATABASE_SSL=<require | verify-full>
# DATABASE_CA_CERT=<PEM de la CA>          # solo con verify-full en hosts sin CA de sistema (ej. Supabase)
DATABASE_POOL_MAX=10
CORS_ORIGINS=<https://tu-dominio.com>      # sin barra final
PUBLIC_URL=<https://api.tu-dominio.com>
STOREFRONT_URL=<https://tu-dominio.com>    # destino del webhook de revalidación
ADMIN_URL=<https://tu-dominio.com>         # el panel va dentro de la tienda (/admin)
TRUST_PROXY=<1>                            # saltos de proxy (Railway=1, Cloudflare+Railway=2); nunca false
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
UPLOAD_DIR=<carpeta persistente>
DOCS_ENABLED=false
JWT_ACCESS_SECRET=<openssl rand -hex 32>
JWT_REFRESH_SECRET=<openssl rand -hex 32>
CUSTOMER_JWT_SECRET=<openssl rand -hex 32>  # distinto del de personal
ENCRYPTION_KEY=<openssl rand -base64 32>    # 32 bytes exactos
PREVIEW_TOKEN_SECRET=<openssl rand -hex 32>
STOREFRONT_REVALIDATE_SECRET=<mismo valor que en el frontend>
STOREFRONT_SERVER_KEY=<mismo valor que en el frontend>
PAYMENT_PROVIDER=wompi
MOCK_PAYMENTS_ENABLED=false
ORDER_RESERVATION_MINUTES=30
WOMPI_API_URL=https://production.wompi.co/v1
WOMPI_PUBLIC_KEY=<pub_prod_xxx>
WOMPI_INTEGRITY_SECRET=<de tu cuenta Wompi>
WOMPI_EVENTS_SECRET=<de tu cuenta Wompi>    # verifica el webhook /webhooks/wompi
MAIL_TRANSPORT=smtp
SMTP_URL=<smtp://usuario:clave@host:587>
MAIL_FROM="Daregular Dept. <no-reply@tu-dominio.com>"
# Solo para crear el primer owner (`yarn owner:create`); bórralas después
# OWNER_EMAIL=<tu correo>
# OWNER_PASSWORD=<12+ caracteres>
