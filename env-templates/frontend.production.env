# FRONTEND · PRODUCCIÓN → `.env.production` o variables del servidor (los secretos NO se commitean)
# Reemplaza TODO lo que está entre < >. Si queda algún < > el build falla a propósito.
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_API_URL=<https://api.tu-dominio.com>      # sin /api/v1, https obligatorio
# API_URL=<http://backend:4000>                       # solo si el servidor Next llega al backend por otra ruta
STOREFRONT_REVALIDATE_SECRET=<mismo valor que en el backend>   # openssl rand -hex 32
STOREFRONT_SERVER_KEY=<mismo valor que en el backend>          # openssl rand -hex 32
NEXT_PUBLIC_WOMPI_PUBLIC_KEY=<pub_prod_xxx>
NEXT_PUBLIC_SITE_URL=<https://tu-dominio.com>
NEXT_PUBLIC_INDEXABLE=true
CATALOG_REVALIDATE_SECONDS=60
CONTENT_REVALIDATE_SECONDS=300
# REDIRECT_ALLOWED_HOSTS=<otro-dominio.com,otro2.com>   # opcional
