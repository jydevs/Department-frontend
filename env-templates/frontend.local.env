# FRONTEND · LOCAL (QA) → copia a `.env.development` (ya existe) o `.env.local`
NEXT_PUBLIC_APP_ENV=qa
NEXT_PUBLIC_API_URL=http://localhost:4000
API_URL=http://localhost:4000
# Debe ser IGUAL al STOREFRONT_REVALIDATE_SECRET del backend local
STOREFRONT_REVALIDATE_SECRET=qa-revalidate-secret-qa-revalidate-0123456789
# STOREFRONT_SERVER_KEY=            # opcional en local; si lo pones, igual al del backend
NEXT_PUBLIC_WOMPI_PUBLIC_KEY=       # vacío: en local se usa la pasarela simulada
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_INDEXABLE=false
CATALOG_REVALIDATE_SECONDS=5
CONTENT_REVALIDATE_SECONDS=10
# REDIRECT_ALLOWED_HOSTS=           # dominios externos permitidos en redirecciones del CMS, separados por coma
