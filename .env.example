# Plantilla de variables. Copia a `.env.local` (cualquier perfil) y ajusta. Ver docs/ENTORNOS.md.
NEXT_PUBLIC_APP_ENV=production

# URL pública del backend (sin /api/v1). Debe ser https y estar en CORS_ORIGINS del backend.
NEXT_PUBLIC_API_URL=<https://api.tu-dominio.com>
# URL interna si el servidor de Next llega al backend por otra ruta (opcional; por defecto = NEXT_PUBLIC_API_URL)
# API_URL=<http://backend:4000>

# Secretos (solo en el servidor, nunca NEXT_PUBLIC_*)
# STOREFRONT_REVALIDATE_SECRET=<mismo valor que STOREFRONT_REVALIDATE_SECRET del backend>
# STOREFRONT_SERVER_KEY=<mismo valor que STOREFRONT_SERVER_KEY del backend>

# Wompi (llave pública de producción: pub_prod_…)
NEXT_PUBLIC_WOMPI_PUBLIC_KEY=<pub_prod_xxx>

# URL canónica del sitio
NEXT_PUBLIC_SITE_URL=<https://tu-dominio.com>
NEXT_PUBLIC_INDEXABLE=true

CATALOG_REVALIDATE_SECONDS=60
CONTENT_REVALIDATE_SECONDS=300
