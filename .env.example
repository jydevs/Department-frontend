# ══ FRONTEND · DESARROLLO ══
# Copia a .env.local (no se versiona). Ningún secreto va en este archivo.

# ── API del backend (sin /api/v1) ────────────────────────────────────────────
# API_URL              Origen que usa el SERVIDOR de Next para leer catálogo y contenido. Puede ser una dirección
#                      interna/privada (http://api:4000). Nunca llega al navegador.
# NEXT_PUBLIC_API_URL  Origen PÚBLICO de la API: lo usa el NAVEGADOR (newsletter, contacto) y es el respaldo de API_URL.
#                      También lo usa el panel de administración (/admin) para hablar con la API desde el navegador;
#                      la API debe tener este sitio en CORS_ORIGINS (el panel usa la cookie de sesión con credentials).
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# ── Imágenes subidas (/media/...) ────────────────────────────────────────────
# NEXT_PUBLIC_MEDIA_URL  Origen PÚBLICO que sirve /media/... Por defecto es NEXT_PUBLIC_API_URL. Debe ser accesible
#                        desde el navegador y desde next/image; NO uses aquí el API_URL interno. Es además el único
#                        host remoto que next/image acepta (next.config.ts → images.remotePatterns, pathname /media/**).
# NEXT_PUBLIC_MEDIA_URL=https://api.example.com

# ── Sitio ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_INDEXABLE=false

# ── Pagos ────────────────────────────────────────────────────────────────────
# Las llaves de Wompi (WOMPI_PUBLIC_KEY, WOMPI_INTEGRITY_SECRET, WOMPI_EVENTS_SECRET) viven SOLO en el backend; aquí no
# se pone ninguna. NEXT_PUBLIC_SITE_URL debe ser igual al STOREFRONT_URL del backend (Wompi vuelve a /checkout/result).
# NEXT_PUBLIC_PAYMENT_PROVIDER=wompi   oculta el simulador /mock-checkout (que ya devuelve 404 con NODE_ENV=production)

# ── Secretos solo de servidor (mismos valores que en el backend) ─────────────
# STOREFRONT_REVALIDATE_SECRET=   firma HMAC del webhook POST /api/revalidate
# STOREFRONT_SERVER_KEY=          X-Storefront-Key: permite reenviar la IP del visitante (X-Visitor-Ip) a la API

# ── PRODUCCIÓN ───────────────────────────────────────────────────────────────
# `next build` / `next start` con NODE_ENV=production EXIGEN NEXT_PUBLIC_API_URL y NEXT_PUBLIC_SITE_URL: si faltan,
# el build falla con un mensaje claro (no se cae a localhost). Defínelas en el entorno del build/CI o en un
# .env.production.local (no versionado). Ejemplo:
#   NEXT_PUBLIC_API_URL=https://api.daregular.com
#   NEXT_PUBLIC_SITE_URL=https://daregular.com
#   NEXT_PUBLIC_INDEXABLE=true
#   API_URL=http://api.internal:4000   (opcional: origen interno para el servidor)
# NEXT_PUBLIC_* se incrusta en el build: cambiarla exige reconstruir.
