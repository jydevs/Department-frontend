# ══ FRONTEND · DESARROLLO ══
# Copia a .env.local (no se versiona). Ningún secreto va en este archivo.

# ── API del backend (sin /api/v1) ────────────────────────────────────────────
# API_URL              Origen que usa el SERVIDOR de Next para leer catálogo y contenido. Puede ser una dirección
#                      interna/privada (http://api:4000). Nunca llega al navegador.
# NEXT_PUBLIC_API_URL  Origen PÚBLICO de la API: lo usa el NAVEGADOR (newsletter, contacto) y es el respaldo de API_URL.
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# ── Imágenes subidas (/media/...) ────────────────────────────────────────────
# NEXT_PUBLIC_MEDIA_URL  Origen PÚBLICO que sirve /media/... Por defecto es NEXT_PUBLIC_API_URL. Debe ser accesible
#                        desde el navegador y desde next/image; NO uses aquí el API_URL interno. Es además el único
#                        host remoto que next/image acepta (next.config.ts → images.remotePatterns, pathname /media/**).
# NEXT_PUBLIC_MEDIA_URL=https://api.example.com

# ── Sitio ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_INDEXABLE=false

# ── Secretos solo de servidor (mismos valores que en el backend) ─────────────
# STOREFRONT_REVALIDATE_SECRET=   firma HMAC del webhook POST /api/revalidate
# STOREFRONT_SERVER_KEY=          X-Storefront-Key: permite reenviar la IP del visitante (X-Visitor-Ip) a la API
